<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="checklist">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="title" type="xs:string"/>
        <xs:element name="flightPhase">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="takeoff"/>
              <xs:enumeration value="cruise"/>
              <xs:enumeration value="landing"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="applicability">
          <xs:complexType>
            <xs:attribute name="aircraft" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="notice" type="xs:string"/>
        <!-- warnings and steps: next message -->
      </xs:sequence>
      <xs:attribute name="id" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

</xs:schema>

